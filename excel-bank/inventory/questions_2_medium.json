[
{"id":"inv-m-01","tier":"medium","topic":"SUMIFS","title":"Units shipped from WH-A","context":"OUT movements at one warehouse.","task":"Sum N2:N81 where Type is \"OUT\" and Warehouse is \"WH-A\".","hint":"SUMIFS.","answer":"=SUMIFS(N2:N81,M2:M81,\"OUT\",O2:O81,\"WH-A\")"},
{"id":"inv-m-02","tier":"medium","topic":"SUMIFS","title":"Units received in March 2025","context":"Date window on IN movements.","task":"Sum N2:N81 where Type is \"IN\" and Date is within March 2025.","hint":"\">=\"&DATE(2025,3,1), \"<=\"&DATE(2025,3,31).","answer":"=SUMIFS(N2:N81,M2:M81,\"IN\",K2:K81,\">=\"&DATE(2025,3,1),K2:K81,\"<=\"&DATE(2025,3,31))"},
{"id":"inv-m-03","tier":"medium","topic":"SUMIFS","title":"Net movement for SKU005","context":"IN minus OUT plus ADJ.","task":"Return SUMIFS(N2:N81,L2:L81,\"SKU005\",M2:M81,\"IN\") − SUMIFS(N2:N81,L2:L81,\"SKU005\",M2:M81,\"OUT\") + SUMIFS(N2:N81,L2:L81,\"SKU005\",M2:M81,\"ADJ\").","hint":"Three SUMIFS.","answer":"=SUMIFS(N2:N81,L2:L81,\"SKU005\",M2:M81,\"IN\")-SUMIFS(N2:N81,L2:L81,\"SKU005\",M2:M81,\"OUT\")+SUMIFS(N2:N81,L2:L81,\"SKU005\",M2:M81,\"ADJ\")"},
{"id":"inv-m-04","tier":"medium","topic":"COUNTIFS","title":"A-class items below reorder point","context":"Critical stock list size.","task":"Return SUMPRODUCT((I2:I41=\"A\")*(F2:F41<=G2:G41)).","hint":"Row-vs-row comparison needs SUMPRODUCT, not COUNTIFS.","answer":"=SUMPRODUCT((I2:I41=\"A\")*(F2:F41<=G2:G41))"},
{"id":"inv-m-05","tier":"medium","topic":"COUNTIFS","title":"Movements per SKU (SKU001)","context":"Activity count.","task":"Return COUNTIFS(L2:L81,\"SKU001\").","hint":"COUNTIF works too.","answer":"=COUNTIFS(L2:L81,\"SKU001\")"},
{"id":"inv-m-06","tier":"medium","topic":"SUMPRODUCT","title":"Inventory value by category (Electronics)","context":"Σ cost × on hand for one category.","task":"Return SUMPRODUCT((C2:C41=\"Electronics\")*E2:E41*F2:F41).","hint":"Mask × cost × qty.","answer":"=SUMPRODUCT((C2:C41=\"Electronics\")*E2:E41*F2:F41)"},
{"id":"inv-m-07","tier":"medium","topic":"SUMPRODUCT","title":"Value of items below reorder point","context":"Money tied up in low-stock items.","task":"Return SUMPRODUCT((F2:F41<=G2:G41)*E2:E41*F2:F41).","hint":"Comparison mask.","answer":"=SUMPRODUCT((F2:F41<=G2:G41)*E2:E41*F2:F41)"},
{"id":"inv-m-08","tier":"medium","topic":"Reorder","title":"Reorder quantity for row 2","context":"Order up to 30 days of demand, minus on hand, never negative.","task":"Return MAX(0, ROUNDUP(H2*30 − F2, 0)).","hint":"MAX(0, …).","answer":"=MAX(0,ROUNDUP(H2*30-F2,0))"},
{"id":"inv-m-09","tier":"medium","topic":"Reorder","title":"Reorder point from lead time","context":"Lead days × daily demand + safety days × daily demand.","task":"For row 2 return ROUNDUP((VLOOKUP(D2,Q2:U7,4,FALSE) + VLOOKUP(\"Safety days\",W2:X4,2,FALSE)) × H2, 0).","hint":"Two lookups then multiply.","answer":"=ROUNDUP((VLOOKUP(D2,Q2:U7,4,FALSE)+VLOOKUP(\"Safety days\",W2:X4,2,FALSE))*H2,0)"},
{"id":"inv-m-10","tier":"medium","topic":"Reorder","title":"Round to order multiple","context":"Orders must be multiples of the 'Order multiple' rule.","task":"Return CEILING(MAX(0,H2*30−F2), VLOOKUP(\"Order multiple\",W2:X4,2,FALSE)).","hint":"CEILING(x, multiple).","answer":"=CEILING(MAX(0,H2*30-F2),VLOOKUP(\"Order multiple\",W2:X4,2,FALSE))"},
{"id":"inv-m-11","tier":"medium","topic":"Days of cover","title":"Stock-out date estimate","context":"Row 2: TODAY() + on hand ÷ daily demand.","task":"Return TODAY() + INT(F2/H2).","hint":"INT of days.","answer":"=TODAY()+INT(F2/H2)"},
{"id":"inv-m-12","tier":"medium","topic":"Days of cover","title":"Safe days of cover, guarded","context":"Avoid #DIV/0! when demand is 0.","task":"For row 15 return IFERROR(F15/H15, \"No demand\").","hint":"IFERROR.","answer":"=IFERROR(F15/H15,\"No demand\")"},
{"id":"inv-m-13","tier":"medium","topic":"Days of cover","title":"SKUs with under 7 days of cover","context":"Count where OnHand ÷ DailyDemand < 7 (demand > 0).","task":"Return SUMPRODUCT((H2:H41>0)*(F2:F41/IF(H2:H41=0,1,H2:H41)<7)).","hint":"Guard the divide inside the array.","answer":"=SUMPRODUCT((H2:H41>0)*(F2:F41/IF(H2:H41=0,1,H2:H41)<7))"},
{"id":"inv-m-14","tier":"medium","topic":"INDEX/MATCH","title":"Item with the most on hand","context":"Name of the SKU with max stock.","task":"Return INDEX(B2:B41, MATCH(MAX(F2:F41), F2:F41, 0)).","hint":"INDEX/MATCH.","answer":"=INDEX(B2:B41,MATCH(MAX(F2:F41),F2:F41,0))"},
{"id":"inv-m-15","tier":"medium","topic":"INDEX/MATCH","title":"Supplier country for row 2, two-way","context":"Look up column by header.","task":"Return INDEX(Q2:U7, MATCH(D2,Q2:Q7,0), MATCH(\"Country\",Q1:U1,0)).","hint":"Two MATCHes.","answer":"=INDEX(Q2:U7,MATCH(D2,Q2:Q7,0),MATCH(\"Country\",Q1:U1,0))"},
{"id":"inv-m-16","tier":"medium","topic":"XLOOKUP","title":"On-time rate for row 2's supplier","context":"Supplier reliability per item.","task":"Return XLOOKUP(D2, Q2:Q7, U2:U7).","hint":"XLOOKUP.","answer":"=XLOOKUP(D2,Q2:Q7,U2:U7)"},
{"id":"inv-m-17","tier":"medium","topic":"XLOOKUP","title":"Last movement of SKU003","context":"Search from the bottom.","task":"Return XLOOKUP(\"SKU003\", L2:L81, K2:K81, \"none\", 0, -1).","hint":"Search mode −1.","answer":"=XLOOKUP(\"SKU003\",L2:L81,K2:K81,\"none\",0,-1)"},
{"id":"inv-m-18","tier":"medium","topic":"IFS","title":"Stock status","context":"≤0 Stockout, ≤ reorder point Low, else OK.","task":"For row 2 return IFS(F2<=0,\"Stockout\", F2<=G2,\"Low\", TRUE,\"OK\").","hint":"IFS.","answer":"=IFS(F2<=0,\"Stockout\",F2<=G2,\"Low\",TRUE,\"OK\")"},
{"id":"inv-m-19","tier":"medium","topic":"Nested IF","title":"Supplier risk","context":"On-time < 0.9 High, < 0.95 Medium, else Low (row 2 supplier).","task":"Return IF(XLOOKUP(D2,Q2:Q7,U2:U7)<0.9,\"High\",IF(XLOOKUP(D2,Q2:Q7,U2:U7)<0.95,\"Medium\",\"Low\")).","hint":"Nested IF on a lookup.","answer":"=IF(XLOOKUP(D2,Q2:Q7,U2:U7)<0.9,\"High\",IF(XLOOKUP(D2,Q2:Q7,U2:U7)<0.95,\"Medium\",\"Low\"))"},
{"id":"inv-m-20","tier":"medium","topic":"Dates","title":"Expected delivery if ordered today","context":"Row 2: TODAY() + supplier lead days.","task":"Return TODAY() + XLOOKUP(D2,Q2:Q7,T2:T7).","hint":"Add lead days.","answer":"=TODAY()+XLOOKUP(D2,Q2:Q7,T2:T7)"},

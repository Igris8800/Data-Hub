"task": "Return IF(CORREL(MONTH(FILTER(A2:A97,B2:B97=\"Sales\")),FILTER(E2:E97,B2:B97=\"Sales\"))>0,\"Rising\",\"Falling\").",
"hint": "Sign of CORREL.",
"answer": "=IF(CORREL(MONTH(FILTER(A2:A97,B2:B97=\"Sales\")),FILTER(E2:E97,B2:B97=\"Sales\"))>0,\"Rising\",\"Falling\")"
},

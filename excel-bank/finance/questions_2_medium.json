"answer": "=SUMIF(B2:B97,\"Marketing\",E2:E97)-SUMIF(B2:B97,\"Marketing\",D2:D97)"
},
{
"id": "fin-m-05",
"tier": "medium",
"topic": "Variance",
"title": "Department variance % (Marketing)",
"context": "Percent text.",
"task": "Return TEXT(SUMIF(B2:B97,\"Marketing\",E2:E97)/SUMIF(B2:B97,\"Marketing\",D2:D97)−1,\"0.0%\").",
"hint": "Ratio − 1.",
"answer": "=TEXT(SUMIF(B2:B97,\"Marketing\",E2:E97)/SUMIF(B2:B97,\"Marketing\",D2:D97)-1,\"0.0%\")"
},
{
"id": "fin-m-06",
"tier": "medium",
"topic": "Variance",
"title": "Material variances count",
"context": "Rows where |actual − budget| / budget exceeds the threshold assumption.",
"task": "Return SUMPRODUCT(--(ABS(E2:E97−D2:D97)/D2:D97 > VLOOKUP(\"Variance threshold\",O2:P5,2,FALSE))).",
"hint": "ABS over arrays vs lookup.",
"answer": "=SUMPRODUCT(--(ABS(E2:E97-D2:D97)/D2:D97>VLOOKUP(\"Variance threshold\",O2:P5,2,FALSE)))"
},
{
"id": "fin-m-07",
"tier": "medium",
"topic": "Variance",
"title": "Favourable variance total",
"context": "Σ (budget − actual) where actual < budget.",

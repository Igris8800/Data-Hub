"hint": "Mask × savings.",
"answer": "=SUMPRODUCT((E2:E97<D2:D97)*(D2:D97-E2:E97))"
},
{
"id": "fin-m-08",
"tier": "medium",
"topic": "Variance",
"title": "Unfavourable variance total",
"context": "Σ (actual − budget) where actual > budget.",
